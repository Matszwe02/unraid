<Container version="2">
  <!-- Delete this file if your repository does not ship Docker apps. -->
  <Name>YT-DLP Web Player</Name>
  <Repository>ghcr.io/matszwe02/ytdlp_web_player:stable</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/ytdlp_web_player</Support>
  <Project>https://github.com/Matszwe02/ytdlp_web_player</Project>
  <Overview>YT-DLP Web Player - Internet video player powered by yt-dlp</Overview>
  <Description>Play any video from the web. No ads, no popups, supports almost every website</Description>
  <Category>MediaApp:Video MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/matszwe02/unraid/main/templates/ytdlp-web-player.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/matszwe02/ytdlp_web_player/main/src/static/favicon.svg</Icon>

  <Config Name="WebUI" Target="5000" Default="5000" Mode="tcp" Description="HTTP port for the WebUI." Type="Port" Display="always" Required="true" Mask="false"/>

<!-- config start -->
  <Config Name="App Title" Target="APP_TITLE" Default="YT-DLP Player"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Theme Color" Target="THEME_COLOR" Default="#ff7300"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Generate Sprite Below" Target="GENERATE_SPRITE_BELOW" Default="1800" Description="generate sprites for videos below this duration (0 to disable)" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Amoled Bg" Target="AMOLED_BG" Default="false"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Max Video Age" Target="MAX_VIDEO_AGE" Default="3600" Description="inactivity after which video is removed" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Max Video Duration" Target="MAX_VIDEO_DURATION" Default="36000"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Default Quality" Target="DEFAULT_QUALITY" Default="720"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Max Quality" Target="MAX_QUALITY" Default="2160"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Autoplay" Target="AUTOPLAY" Default="false"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Min Live Buffer" Target="MIN_LIVE_BUFFER" Default="1" Description="prevent livestreams from having less buffer than this value, in seconds (0 to disable)" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Always Transcode" Target="ALWAYS_TRANSCODE" Default="false"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Disable Transcoding" Target="DISABLE_TRANSCODING" Default="false" Description="useful for low-performance machines, only basic features will work" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Max Processes" Target="MAX_PROCESSES" Default="5" Description="number of FFMPEG and YT-DLP processes combined, allowed to run at once" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Autoskip Sb Segments" Target="AUTOSKIP_SB_SEGMENTS" Default="" Description="comma separated, e.g. selfpromo,outro,sponsor,preview,interaction,intro,music_offtopic" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Cookies Only On Failure" Target="COOKIES_ONLY_ON_FAILURE" Default="true" Description="only use cookies if necessary" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Auto Bg Playback" Target="AUTO_BG_PLAYBACK" Default="true" Description="keep playing videos in background after leaving application or locking screen" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Audio Visualizer" Target="AUDIO_VISUALIZER" Default="false"  Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Proxies" Target="PROXIES" Default="local" Description="proxies for accessing videos to try until it finds a working one, e.g. &quot;local,http://127.0.0.1:8888&quot;; local = no proxy" Type="Variable"  Display="always" Required="false" Mask="false"/>
  <Config Name="Publish With Cloudflare" Target="PUBLISH_WITH_CLOUDFLARE" Default="false" Description="set to true to generate a temporary public link with https" Type="Variable"  Display="always" Required="false" Mask="false"/>
<!-- config end -->

</Container>
