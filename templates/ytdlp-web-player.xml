<Container version="2">
  <!-- Delete this file if your repository does not ship Docker apps. -->
  <Name>YT-DLP Web Player</Name>
  <Repository>ghcr.io/matszwe02/ytdlp_web_player:stable</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/ytdlp_web_player</Support>
  <Project>https://github.com/Matszwe02/ytdlp_web_player</Project>
  <Overview>YT-DLP Web Player - Internet video player powered by yt-dlp</Overview>
  <Description>Play any video from the web. No ads, no popups, supports almost every website</Description>
  <Category>MediaApp:Video MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/matszwe02/unraid/main/templates/ytdlp-web-player.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/matszwe02/ytdlp_web_player/main/src/static/favicon.svg</Icon>
</Container>
